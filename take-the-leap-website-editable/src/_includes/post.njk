---
layout: base.njk
---
<article>
  <header class="page-hero">
    <div class="wrap post-head">
      <span class="post-meta">{{ category or "Pitching" }} · {{ readTime or "4 min read" }}</span>
      <h1>{{ title }}</h1>
      <p class="date">By Victoria Howe · <time datetime="{{ page.date.toISOString().slice(0, 10) }}">{{ page.date | readableDate }}</time></p>
    </div>
  </header>
  <div class="wrap">
    <div class="post-content">
      {{ content | safe }}
    </div>
  </div>
</article>

<section class="section">
  <div class="wrap">
    <p style="max-width:680px;margin-inline:auto"><a class="btn btn-line" href="/blog/">← All posts</a></p>
  </div>
</section>

{% set ctaText = "Want to work on your pitch together? Book a session, or bring me in to work with your whole cohort." %}
{% include "cta.njk" %}
