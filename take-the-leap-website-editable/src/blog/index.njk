---
layout: base.njk
title: Blog
fullTitle: "Blog | Pitching & Communication Tips from Victoria Howe"
description: Notes on pitching, communication and founder confidence from Victoria Howe.
---
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Blog</span>
    <h1>Notes on <em>pitching.</em></h1>
    <p class="lede">Practical thinking on pitching, communication and confidence, from a decade of reading people under pressure.</p>
  </div>
</section>

<section class="section tight" style="padding-top:0">
  <div class="wrap">
    <div class="post-grid">
      {%- for post in collections.posts | reverse %}
      <a href="{{ post.url }}" class="post-card">
        <span class="post-meta">{{ post.data.category or "Pitching" }} · {{ post.data.readTime or "4 min read" }}</span>
        <h2>{{ post.data.title }}</h2>
        <p>{{ post.data.excerpt }}</p>
        <span class="more">Read it →</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

{% include "cta.njk" %}
